meta {
  name: 03 Checkout cart (simulates failed order)
  type: http
  seq: 3
}

post {
  url: {{cartServiceUrl}}/carts/{{retryCartId}}/checkout
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "expectedVersion": {{retryCartVersion}}
  }
}

assert {
  res.status: eq 200
  res.body.status: eq CHECKED_OUT
}

docs {
  Normally only order-service calls this. Calling it by hand gives the state after a failed order: cart closed, no order.
  expectedVersion is the cart version from request 02, the one the customer saw in the order summary.
}
