meta {
  name: 12 Get archived product
  type: http
  seq: 12
}

get {
  url: {{productServiceUrl}}/products/archived/{{temporaryProductId}}
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.body.id: eq {{temporaryProductId}}
  res.body.name: eq Ksiazka testowa - wydanie 2
  res.body.variants[0].stockKeepingUnit: eq BOOK-1
  res.body.archivedAt: isString
}

docs {
  Deleting a product only withdraws it from sale. It is kept as archived for the retention period, so it can still be looked up here.
}
