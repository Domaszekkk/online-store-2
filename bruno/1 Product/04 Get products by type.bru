meta {
  name: 04 Get products by type
  type: http
  seq: 4
}

get {
  url: {{productServiceUrl}}/products?type=COMPUTER
  body: none
  auth: none
}

params:query {
  type: COMPUTER
}

assert {
  res.status: eq 200
  res.body.items: isArray
  res.body.page: eq 0
  res.body.size: eq 20
  res.body.totalItems: isNumber
}
