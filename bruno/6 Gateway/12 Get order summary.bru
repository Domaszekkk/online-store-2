meta {
  name: 12 Get order summary
  type: http
  seq: 12
}

get {
  url: {{gatewayUrl}}/shop/orders/{{gatewayOrderId}}
  body: none
  auth: none
}

script:pre-request {
  await new Promise(resolve => setTimeout(resolve, 1000));
}

assert {
  res.status: eq 200
  res.body.orderNumber: startsWith ORD-
  res.body.status: eq CONFIRMED
  res.body.documentNumber: startsWith FV/
  res.body.deliveryCost.amount: eq 19.99
  res.body.lines[0].quantity: eq 2
  res.body.lines[0].addOns[0].name: eq Kabel HDMI 2m
  res.body.cartId: isUndefined
  res.body.lines[0].stockKeepingUnit: isUndefined
}

docs {
  After the order: CONFIRMED with the invoice number, because invoice-service already issued the invoice (request 11 waited for the PDF).
}
