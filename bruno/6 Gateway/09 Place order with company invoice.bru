meta {
  name: 09 Place order with company invoice
  type: http
  seq: 9
}

post {
  url: {{gatewayUrl}}/shop/orders
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "cartId": "{{gatewayCartId}}",
    "cartVersion": {{gatewayCartVersion}},
    "customer": { "firstName": "Jan", "lastName": "Kowalski", "email": "{{customerEmail}}", "phone": "+48 600 100 200" },
    "shippingAddress": { "street": "Marszałkowska 1", "city": "Warszawa", "postalCode": "00-001", "country": "Polska" },
    "billingAddress": {
      "companyName": "Kowalski Sp. z o.o.",
      "taxIdentificationNumber": "5260250274",
      "street": "Firmowa 5", "city": "Kraków", "postalCode": "30-001", "country": "Polska"
    },
    "paymentMethod": "BLIK",
    "deliveryMethod": "COURIER"
  }
}

assert {
  res.status: eq 201
  res.body.status: eq NEW
  res.body.grandTotal.amount: eq 9256.99
  res.body.billingAddress.taxIdentificationNumber: eq "5260250274"
  res.body.lines[0].vatRate: isUndefined
}

script:post-response {
  if (res.getStatus() === 201) {
    bru.setEnvVar("gatewayOrderId", res.getBody().id);
  }
}

docs {
  Screen 3: "Place order" with the data entered on screen 2 ("I want an invoice" and "for a company" checked).
  9237.00 + 19.99 courier = 9256.99.
}
