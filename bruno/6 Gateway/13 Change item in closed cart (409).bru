meta {
  name: 13 Change item in closed cart (409)
  type: http
  seq: 13
}

patch {
  url: {{gatewayUrl}}/shop/carts/{{gatewayCartId}}/items/{{gatewayItemId}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "quantity": 1
  }
}

assert {
  res.status: eq 409
  res.body.message: contains CHECKED_OUT
}
