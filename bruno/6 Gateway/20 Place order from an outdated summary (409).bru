meta {
  name: 20 Place order from an outdated summary (409)
  type: http
  seq: 20
}

post {
  url: {{gatewayUrl}}/shop/orders
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "cartId": "{{changedCartId}}",
    "cartVersion": {{changedCartVersion}},
    "customer": { "firstName": "Jan", "lastName": "Kowalski", "email": "{{customerEmail}}", "phone": "+48 600 100 200" },
    "shippingAddress": { "street": "Marszałkowska 1", "city": "Warszawa", "postalCode": "00-001", "country": "Polska" },
    "paymentMethod": "BLIK",
    "deliveryMethod": "COURIER"
  }
}

assert {
  res.status: eq 409
  res.body.message: contains has changed since the order summary was prepared
}

docs {
  The customer saw 4618.99 on screen 3, but the cart now holds 3 laptops. The order is not placed;
  the frontend shows the summary again (POST /shop/orders/preview) with the new total and version.
}
