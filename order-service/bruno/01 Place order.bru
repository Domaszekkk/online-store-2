meta {
  name: 01 Place order
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/orders
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "cartId": "{{cartId}}",
    "customer": {
      "firstName": "Jan",
      "lastName": "Kowalski",
      "email": "{{customerEmail}}",
      "phone": "+48 600 100 200"
    },
    "shippingAddress": {
      "street": "Marszałkowska 1",
      "city": "Warszawa",
      "postalCode": "00-001",
      "country": "Polska"
    },
    "paymentMethod": "BLIK",
    "deliveryMethod": "COURIER"
  }
}

script:post-response {
  if (res.getStatus() === 201) {
    bru.setEnvVar("orderId", res.getBody().id);
  }
}

docs {
  cartId: id of a cart with items, created in the cart-service collection (01 Create cart + 03 Add item to cart).
  billingAddress is optional - an invoice is issued only for orders that have it.
  Placing a second order from the same cart returns 409 (the cart is already CHECKED_OUT).
}
