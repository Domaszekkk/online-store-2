meta {
  name: 06 Checkout cart
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/carts/{{cartId}}/checkout
  body: none
  auth: none
}

docs {
  Normally called by order-service when an order is placed (POST /orders).
  Calling it by hand closes the cart, so an order can no longer be placed from it.
}
