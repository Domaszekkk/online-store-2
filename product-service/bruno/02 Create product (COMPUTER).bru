meta {
  name: 02 Create product (COMPUTER)
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/products
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "ProBook X15",
    "type": "COMPUTER",
    "description": "Laptop biznesowy 15.6 cala",
    "basePrice": { "amount": 3999.00, "currency": "PLN" },
    "attributes": { "ekran": "15.6", "waga": "1.7kg" },
    "options": [
      { "name": "Procesor", "position": 1, "values": ["i5", "i7", "i9"] },
      { "name": "RAM", "position": 2, "values": ["8GB", "16GB", "32GB"] }
    ],
    "variants": [
      { "stockKeepingUnit": "PBX15-I7-16", "optionValues": { "Procesor": "i7", "RAM": "16GB" }, "price": { "amount": 4599.00, "currency": "PLN" }, "availability": "AVAILABLE" },
      { "stockKeepingUnit": "PBX15-I9-32", "optionValues": { "Procesor": "i9", "RAM": "32GB" }, "price": { "amount": 5799.00, "currency": "PLN" }, "availability": "COMING_SOON" }
    ],
    "addOns": [
      { "productId": "{{addOnProductId}}", "name": "Kabel HDMI 2m", "price": { "amount": 39.00, "currency": "PLN" } }
    ]
  }
}

script:post-response {
  if (res.getStatus() === 201) {
    bru.setEnvVar("productId", res.getBody().id);
  }
}
